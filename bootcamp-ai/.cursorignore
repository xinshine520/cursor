# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
# Cursor 忽略文件配置
# 此文件指定 Cursor AI 应该忽略哪些文件和目录

# ============================================
# Node.js / JavaScript / TypeScript 相关
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
package-lock.json
yarn.lock
pnpm-lock.yaml
uv.lock

# ============================================
# Python 相关
# ============================================
# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python 包信息
*.egg-info/
*.egg
dist/
build/
*.whl

# Python 工具缓存
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
cython_debug/

