**/scripts/generate_test_data.py

# 如果不需要 AI 分析测试文件
tests/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# 如果不需要 AI 分析 API 测试文件
test-api*.py
test-api*.md
test.rest
*.rest

# Mock 数据和测试数据文件
pocket-mock.json
**/*mock*.json

# 数据库迁移文件（可选：如果不需要 AI 分析迁移历史）
alembic/versions/*.py

