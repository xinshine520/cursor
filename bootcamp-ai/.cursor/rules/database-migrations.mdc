# 数据库迁移规范

## Alembic 迁移规范

### 迁移文件命名

**使用描述性名称，格式：`{revision}_{description}.py`**

```python
# ✅ GOOD
108660d9a44c_fix_enum_case_to_lowercase.py
e0f1abcb761f_initial_schema_tickets_labels_ticket_.py

# ❌ BAD - 避免模糊的名称
abc123_update.py
xyz789_change.py
```

### 迁移内容要求

**所有迁移必须可逆（包含 upgrade 和 downgrade）**：

```python
# ✅ GOOD
def upgrade() -> None:
    op.create_table(
        'tickets',
        sa.Column('id', sa.Integer(), nullable=False),
        sa.Column('title', sa.String(), nullable=False),
        sa.PrimaryKeyConstraint('id')
    )

def downgrade() -> None:
    op.drop_table('tickets')
```

### 迁移前检查

**迁移前必须检查当前数据库状态**：

```python
# ✅ GOOD - 检查表是否存在
def upgrade() -> None:
    if not op.get_bind().dialect.has_table(op.get_bind(), 'tickets'):
        op.create_table('tickets', ...)
    else:
        # 表已存在，执行其他操作
        pass
```

## 迁移操作规范

### 创建表

**使用明确的列定义和约束**：

```python
# ✅ GOOD
def upgrade() -> None:
    op.create_table(
        'tickets',
        sa.Column('id', sa.Integer(), nullable=False, primary_key=True),
        sa.Column('title', sa.String(200), nullable=False),
        sa.Column('description', sa.Text(), nullable=True),
        sa.Column('status', sa.String(20), nullable=False, server_default='open'),
        sa.Column('created_at', sa.DateTime(), nullable=False, server_default=sa.func.now()),
        sa.Column('updated_at', sa.DateTime(), nullable=False, server_default=sa.func.now()),
        sa.CheckConstraint("status IN ('open', 'in_progress', 'closed')", name='check_status'),
    )

def downgrade() -> None:
    op.drop_table('tickets')
```

### 添加列

**使用 server_default 设置默认值**：

```python
# ✅ GOOD
def upgrade() -> None:
    op.add_column('tickets', sa.Column('priority', sa.String(10), nullable=True))
    op.alter_column('tickets', 'priority', server_default='normal')

def downgrade() -> None:
    op.drop_column('tickets', 'priority')
```

### 修改列

**明确指定修改的类型和约束**：

```python
# ✅ GOOD
def upgrade() -> None:
    op.alter_column('tickets', 'title',
                    existing_type=sa.String(100),
                    type_=sa.String(200),
                    nullable=False)

def downgrade() -> None:
    op.alter_column('tickets', 'title',
                    existing_type=sa.String(200),
                    type_=sa.String(100),
                    nullable=False)
```

### 创建索引

**为常用查询字段创建索引**：

```python
# ✅ GOOD
def upgrade() -> None:
    op.create_index('ix_tickets_status', 'tickets', ['status'])
    op.create_index('ix_tickets_created_at', 'tickets', ['created_at'])

def downgrade() -> None:
    op.drop_index('ix_tickets_created_at', table_name='tickets')
    op.drop_index('ix_tickets_status', table_name='tickets')
```

### 外键约束

**明确指定外键关系和级联操作**：

```python
# ✅ GOOD
def upgrade() -> None:
    op.create_foreign_key(
        'fk_ticket_label_ticket_id',
        'ticket_labels', 'tickets',
        ['ticket_id'], ['id'],
        ondelete='CASCADE'
    )

def downgrade() -> None:
    op.drop_constraint('fk_ticket_label_ticket_id', 'ticket_labels', type_='foreignkey')
```

## 数据迁移

### 迁移现有数据

**使用 op.execute() 执行数据迁移**：

```python
# ✅ GOOD
def upgrade() -> None:
    # 添加新列
    op.add_column('tickets', sa.Column('new_status', sa.String(20), nullable=True))
    
    # 迁移数据
    op.execute("""
        UPDATE tickets 
        SET new_status = CASE 
            WHEN status = 'open' THEN 'active'
            WHEN status = 'closed' THEN 'inactive'
            ELSE 'pending'
        END
    """)
    
    # 设置非空约束
    op.alter_column('tickets', 'new_status', nullable=False)
    
    # 删除旧列
    op.drop_column('tickets', 'status')
    op.rename_column('tickets', 'new_status', 'status')

def downgrade() -> None:
    # 反向操作
    op.add_column('tickets', sa.Column('old_status', sa.String(20), nullable=True))
    op.execute("""
        UPDATE tickets 
        SET old_status = CASE 
            WHEN status = 'active' THEN 'open'
            WHEN status = 'inactive' THEN 'closed'
            ELSE 'open'
        END
    """)
    op.drop_column('tickets', 'status')
    op.rename_column('tickets', 'old_status', 'status')
```

## 迁移最佳实践

### 1. 迁移前备份

**生产环境迁移前必须备份数据库**：

```bash
# 备份数据库
pg_dump -U postgres -d tickethub > backup_$(date +%Y%m%d_%H%M%S).sql
```

### 2. 测试迁移

**在开发环境测试迁移和回滚**：

```bash
# 测试升级
alembic upgrade head

# 测试回滚
alembic downgrade -1

# 再次升级
alembic upgrade head
```

### 3. 迁移顺序

**确保迁移按正确顺序执行**：

```python
# ✅ GOOD - 先创建被引用的表
def upgrade() -> None:
    # 1. 创建 labels 表
    op.create_table('labels', ...)
    
    # 2. 创建 tickets 表
    op.create_table('tickets', ...)
    
    # 3. 创建关联表（引用前两个表）
    op.create_table('ticket_labels', ...)
```

### 4. 迁移版本管理

**不要修改已提交的迁移文件**：

```bash
# ✅ GOOD - 创建新的迁移
alembic revision -m "add_priority_column"

# ❌ BAD - 不要修改已存在的迁移文件
# 如果迁移已应用到生产环境，创建新的迁移来修复
```

## 禁止事项

- ❌ 不要直接修改数据库（使用 Alembic 迁移）
- ❌ 不要修改已提交的迁移文件（创建新迁移）
- ❌ 不要在生产环境直接运行 SQL（使用迁移）
- ❌ 不要在迁移中使用硬编码的 ID（使用序列）
- ❌ 不要忽略迁移的回滚操作（downgrade）
- ❌ 不要在迁移中执行长时间运行的操作（分批处理）

## 迁移命令

### 创建迁移

```bash
# 自动生成迁移（推荐）
alembic revision --autogenerate -m "description"

# 手动创建空迁移
alembic revision -m "description"
```

### 应用迁移

```bash
# 升级到最新版本
alembic upgrade head

# 升级一个版本
alembic upgrade +1

# 降级一个版本
alembic downgrade -1

# 降级到特定版本
alembic downgrade <revision>
```

### 查看迁移历史

```bash
# 查看当前版本
alembic current

# 查看迁移历史
alembic history

# 查看迁移详情
alembic show <revision>
```
