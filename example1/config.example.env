# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI模型名称（可选，默认：gpt-4o-mini）
# 可选值：gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo 等
OPENAI_MODEL=gpt-4o-mini
# OpenAI API基础URL（可选，用于自定义API端点或兼容OpenAI的API）
# 例如：https://api.openai.com/v1 或 https://your-custom-api.com/v1
# OPENAI_API_URL=https://api.openai.com/v1

# 天气API配置（可选，使用OpenWeatherMap）
# 注册地址：https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here
# 天气API基础URL（可选，默认：https://api.openweathermap.org/data/2.5/weather）
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# 新闻API配置（可选，使用NewsAPI）
# 注册地址：https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here
# 新闻API基础URL（可选，默认：https://newsapi.org/v2/top-headlines）
# NEWS_API_URL=https://newsapi.org/v2/top-headlines

